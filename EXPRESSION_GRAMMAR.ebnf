(* Expression grammar for snake part 4 *)

(* Optional comparison expressions: *)
expression = arithmetic, [ comparison, arithmetic ] ;
comparison = "==" | "!=" | "<" | ">" | "<=" | ">=" ;

(* Addition and subtraction: *)
arithmetic = term, { ("+" | "-"), term } ;

(* Multiplication and division: *)
term = factor, { ("*" | "/"), factor } ;

(* Numbers, variables, and expressions in parentheses: *)
factor = number | identifier | "(", expression, ")" ;

number = digit, { digit }, [ ".", digit, { digit } ] ;
identifier = letter, { letter | digit | "_" } ;
letter = "A" ... "Z" | "a" ... "z" ;
digit = "0" ... "9" ;

(* The ... indicates all characters in the range. Keywords may not be used as
variable names. The current lexer allows some non-English digits and
characters but they have to be made to be compatible with the full grammar.
Other features not in this grammar include function calls, boolean constants, 
statements, and unary minus. Comparisons can only be between numbers and produce
a boolean result. Chained comparisons like 1 < 2 < 3 are not allowed. Comparisons
may appear inside parentheses, but using a boolean in arithmetic or in another
comparison is an error. *)